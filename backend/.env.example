# REQUIRED: 32+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=3000
NODE_ENV=development
DB_PATH=./data/vylo.db
# Identifies your app to OSM services (Nominatim policy). Use a real email or URL.
UPSTREAM_CONTACT=
# --- Only when hosting frontend on a DIFFERENT domain than the API ---
SERVE_FRONTEND=true
# Comma-separated frontend origins, e.g. https://vylo.example.com  (never '*')
ALLOWED_ORIGIN=
# strict (same site) | lax | none (cross-site; forces Secure cookies, needs HTTPS)
COOKIE_SAMESITE=strict
